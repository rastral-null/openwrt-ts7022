CONFIG_TARGET_rtl819x=y
CONFIG_TARGET_rtl819x_rtl8197f=y
CONFIG_TARGET_rtl819x_rtl8197f_DEVICE_transerv_ts7022=y
CONFIG_FEED_luci=y
CONFIG_FEED_packages=y
CONFIG_LUCI_LANG_ru=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_liblucihttp=y
CONFIG_PACKAGE_liblucihttp-ucode=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-ts7022=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-base-ru=y
CONFIG_PACKAGE_luci-i18n-firewall-ru=y
CONFIG_PACKAGE_luci-i18n-package-manager-ru=y
CONFIG_PACKAGE_luci-i18n-ts7022-ru=y
CONFIG_PACKAGE_luci-lib-uqr=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
# Footstrap: собирается (m), но в образ не ставится - раздел rootfs на
# 3,73 МБ занят на 98%, тема весит +209 КБ. Пакет кладём в релиз, ставится
# на устройство в overlay: apk add --allow-untrusted --force-non-repository
CONFIG_PACKAGE_luci-theme-footstrap=m
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-log=y
CONFIG_PACKAGE_ucode-mod-nl80211=y
CONFIG_PACKAGE_ucode-mod-rtnl=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_swconfig=y
# ZRAM: сжатый swap в ОЗУ (128 МБ без свопа). Размер по умолчанию -
# MemTotal/2048 (для 128 МБ это ~61 МБ), алгоритм lzo-rle; правится в
# /etc/config/system: system.@system[0].zram_size_mb / zram_comp_algo.
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y
# ...и сам swap в ядре: у цели rtl819x он выключен (SMALL_FLASH),
# без CONFIG_SWAP нет /proc/swaps и zram-swap выходит с ошибкой.
CONFIG_KERNEL_SWAP=y
# Ядро: nvmem - чтение заводского MAC из hwconfig (ячейка "mac-address" в boot)
CONFIG_NVMEM=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
