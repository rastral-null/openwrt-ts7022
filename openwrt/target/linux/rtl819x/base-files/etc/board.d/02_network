#!/bin/sh

. /lib/functions/uci-defaults.sh

board_config_update

# TRANSERV TS-7022: гнёзда сидят на внешнем коммутаторе RTL8367RB-VB
# (драйвер rtl8367b, swconfig switch0). Порт 0 - синий WAN, порты 1..4 -
# LAN1..LAN4, порт 6 - процессор (RGMII, ext_id 1). Порты 5 и 7 не
# разведены.
#
# ucidef_add_switch собирает из строк port:role две группы: lan (первая)
# и wan (вторая). Номера VLAN у групп получаются 1 и 2, а устройства -
# eth0.1 и eth0.2. На первой загрузке uci-defaults/06_switch_vlan_ids
# переименовывает их в стоковые 9 (LAN) и 8 (WAN) с FID 1 у WAN - ровно
# эти номера ждёт внутренний коммутатор 8197F (rtl819x_eth.c), который
# пропускает к процессору только метки 8 и 9.
#
# WAN явно объявлен как dhcp: без этого config_generate оставил бы ему
# proto=none, и адрес от провайдера не запрашивался бы сам.
#
# LAN — 192.168.1.1, стандарт OpenWrt. Стоковый 192.168.0.254 не годится:
# на стенде 192.168.0.1 занят вышестоящим устройством (MAC e4:26:86:77:39:8e,
# отвечает по HTTP), и WAN получает от него DHCP в той же подсети — LAN
# в 192.168.0.0/24 дал бы два адреса на один маршрут.
ucidef_add_switch "switch0" \
	"1:lan" "2:lan" "3:lan" "4:lan" "0:wan" "6t@eth0"
ucidef_set_interface "wan" protocol "dhcp"
ucidef_set_interface "lan" protocol "static" ipaddr "192.168.1.1" netmask "255.255.255.0"

board_config_flush

exit 0
